<Window x:Class="DiaryApp.Windows.FilmsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiaryApp.Windows"
        mc:Ignorable="d"
        Closed="Window_Closed"
        Title="Фильмы" Height="350" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="FilmsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="3" Width="auto" Height="auto" Margin="25 0 25 0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding name_film}" Width="*"/>
                <DataGridTextColumn Header="Режиссёр" Binding="{Binding director}" Width="*"/>
                <DataGridTextColumn Header="Начало" Binding="{Binding start}" Width="Auto"/>
                <DataGridTextColumn Header="Окончание" Binding="{Binding finish}" Width="Auto"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding status}" Width="Auto"/>
                <DataGridTextColumn Header="Оценка" Binding="{Binding grade}" Width="Auto"/>
                <DataGridTextColumn Header="Заметка" Binding="{Binding note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Viewbox Stretch="Uniform" Grid.Row="2" Grid.ColumnSpan="3">
            <Grid Width="800" Height="100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Background="#5D76CB" Grid.Row="2" Grid.Column="0" Height="80" Width="130" FontSize="25" FontWeight="Bold" x:Name="butAddNewFilm" Content="Добавить" Click="butAddNewFilm_Click"  ></Button>
                <Button Background="#5D76CB" Grid.Row="2" Grid.Column="1" Height="80" Width="130" FontSize="25" FontWeight="Bold" x:Name="butEditFilm" Content="Изменить" Click="butEditFilm_Click" ></Button>
                <Button Background="Red" Grid.Row="2" Grid.Column="2" Height="80" Width="130" FontSize="25" FontWeight="Bold" x:Name="butDeleteFilm" Content="Удалить" Click="butDeleteFilm_Click" ></Button>

            </Grid>
        </Viewbox>
    </Grid>
</Window>
