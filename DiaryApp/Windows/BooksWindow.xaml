<Window x:Class="DiaryApp.Windows.BooksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiaryApp.Windows"
        mc:Ignorable="d"
        Title="Книги" Height="350" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="3" Background="Pink" Width="auto" Height="auto" Margin="25 0 25 0">
            
        </DataGrid>

        <Viewbox Stretch="Uniform" Grid.Row="2" Grid.ColumnSpan="3">
            <Grid Width="800" Height="100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Background="#5D76CB" Grid.Row="2" Grid.Column="0" Height="80" Width="130" FontSize="25" FontWeight="Bold" x:Name="butAddNewBook" Content="Добавить" Click="butAddNewBook_Click" ></Button>
                <Button Background="#5D76CB" Grid.Row="2" Grid.Column="1" Height="80" Width="130" FontSize="25" FontWeight="Bold" x:Name="butEditBook" Content="Изменить" Click="butEditBook_Click" ></Button>
                <Button Background="Red" Grid.Row="2" Grid.Column="2" Height="80" Width="130" FontSize="25" FontWeight="Bold" x:Name="butDeleteBook" Content="Удалить" Click="butDeleteBook_Click" ></Button>

            </Grid>
        </Viewbox>
    </Grid>
</Window>
